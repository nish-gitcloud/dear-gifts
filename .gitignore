# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# locally-written uploads (services/cloudinary.ts's no-credentials fallback) —
# only ever present without real Cloudinary keys configured; never meant to
# be committed to the repo.
/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts
